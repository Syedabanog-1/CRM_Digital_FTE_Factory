# Stage 2 Production Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://fte:fte_password@localhost:5432/fte_crm
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=fte-workers

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Gmail
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications
GMAIL_USER_ID=me

# API
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
